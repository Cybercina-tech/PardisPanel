# Copy to .env.local and adjust. Vite loads VITE_* from .env, .env.local, .env.[mode].local

# Django API during `npm run dev` (Docker service name or host:port)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Port Vite listens on (inside container or locally)
# VITE_DEV_SERVER_PORT=5173

# When the browser URL uses a different port than Vite (e.g. port mapping 5250 -> 5173),
# set the browser-visible port so HMR WebSocket connects (fixes "failed to connect to websocket").
# VITE_HMR_CLIENT_PORT=5250
# VITE_HMR_HOST=localhost

# Optional: public origin when a reverse proxy serves the dev app
# VITE_DEV_ORIGIN=http://localhost:5250

# Set to false if the dev port is busy and you want Vite to pick another port
# VITE_DEV_STRICT_PORT=false
